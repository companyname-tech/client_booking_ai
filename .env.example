# Backend API base URL (no trailing slash).
#
# Leave empty (or unset) to use the default same-origin `/api` path, which
# vite.config.ts reverse-proxies to the leads_to_conversion backend on
# 127.0.0.1:8870 (rewriting `/api` off). Same-origin is REQUIRED for the
# HttpOnly `access_token` cookie auth to work.
#
# Set this only when the SPA and the API are served from different origins;
# note that a cross-origin value breaks cookie auth unless your proxy/CORS is
# adjusted accordingly.
VITE_API_URL=
